<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Enforces that @Deprecated and the Javadoc @deprecated tag are always used
  together. This runs at build time in place of a unit test that used
  reflection to check for the @Deprecated annotation at runtime.
-->
<module name="Checker">
  <module name="TreeWalker">
    <module name="MissingDeprecated"/>
  </module>
</module>
